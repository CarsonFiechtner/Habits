<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (design doc §13): back up the database and settings to the Google account,
     and include them when transferring to a new phone. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
